    BATCH_COUNT : INT AT %QW7 := 0;
    PACKAGE_COUNT : INT AT %QW8 := 0;
    BATCH_FULL : BOOL := FALSE;
    BATCH_NOT_READY : BOOL := FALSE;
    PACKAGING_ACTIVE : BOOL AT %QX1.6 := FALSE;
    PACKAGING_DONE : BOOL := FALSE;
    SIMULATOR : PRODUCT_SIMULATOR;
    DEFECT_PERCENT : INT AT %QW2 := 25;
  END_VAR

