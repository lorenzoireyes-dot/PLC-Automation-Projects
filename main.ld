    PROCESS_ACTIVE : BOOL := FALSE;
    PROCESS_DONE : BOOL := FALSE;
    PROCESS_TIMER : TON;
    PROCESSOR : BOOL AT %QX1.3 := FALSE;
    WAIT_CLEAR : BOOL := FALSE;
    INSPECTION_ACTIVE : BOOL AT %QX1.4 := FALSE;
    INSPECTION_DONE : BOOL := FALSE;
    INSPECTION_TIMER : TON;
    QUALITY_FAIL : BOOL AT %QX2.1 := FALSE;
    REJECT_ACTIVE : BOOL AT %QX1.5 := FALSE;
    REJECT_PULSE : BOOL := FALSE;
    PRODUCT_ACCEPTED : BOOL := FALSE;
    PRODUCT_REJECTED : BOOL := FALSE;
